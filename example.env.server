G_CLIENT_ID=
G_CLIENT_SECRET=
JWT_SECRET=
INIT_TABLE=true
ENABLE_CACHE=true
NEWSNOW_CACHE_TTL_MS=300000
# Optional reviewed selector profile. It retains the full API registry while applying 5/10/30-minute intervals to its 30 canonical sources.
NEWSNOW_SOURCE_PROFILE=production-30
NEWSNOW_SOURCE_INTERVAL_OVERRIDES=
# Informational only; use an immutable image digest to identify reviewed deployment content.
# Start with: NEWSNOW_DECLARED_REVISION=$(git rev-parse HEAD) docker compose up -d --build
NEWSNOW_DECLARED_REVISION=
PRODUCTHUNT_API_TOKEN=
